        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "OracleSource",
            "oracleReaderQuery": "SELECT\n    part_no,\n    CASE \n        WHEN part_no LIKE 'P%' THEN 'Pneumatic' \n        WHEN part_no LIKE 'S%' OR part_no LIKE '3%' THEN 'Solid' \n        ELSE NULL \n    END AS Item,\nwarehouse,\nlocation_no,\n    COUNT(serial_no) AS total_qty,\n    sum(QTY_ONHAND) - sum(QTY_RESERVED)AS on_hand_qty\nFROM\n    ifsapp.inventory_part_in_stock_uiv\nWHERE\n    (warehouse IN ('RDDF', 'FG1')\n    OR location_no IN (\n        'ST1-FG-A', \n        'PMGF2', \n        'PMGF', \n        'ST3-FG-A', \n        'ST3-HL-0001-FG', \n        'ST2-FG-A', \n        'ST1-FG-A'))\n    AND (part_no LIKE 'P%' OR part_no LIKE 'S%' OR part_no LIKE '3%')\n    AND (qty_onhand > 0 OR qty_in_transit > 0)\nGROUP BY\n    part_no,\nwarehouse,\nlocation_no,\n    CASE \n        WHEN part_no LIKE 'P%' THEN 'Pneumatic' \n        WHEN part_no LIKE 'S%' OR part_no LIKE '3%' THEN 'Solid' \n        ELSE NULL \n    END",
