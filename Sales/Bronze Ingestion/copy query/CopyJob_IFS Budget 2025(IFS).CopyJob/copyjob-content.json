        "source": {
          "datasetSettings": {
            "querySettings": {
              "queryName": "IFS Budget 2025(IFS) Ingestion",
              "query": "select\r\na.code_c as Customer_ID,\r\na.code_c_desc as Customer_Name,\r\nTO_DATE(\r\n        CASE \r\n            WHEN a.budget_period >= 10 THEN \r\n                (a.budget_year + 1) || '-' || (a.budget_period - 9)\r\n            ELSE \r\n                a.budget_year || '-' || (a.budget_period + 3)\r\n        END,\r\n        'YYYY-MM'\r\n    ) AS Month,\r\na.quantity as SalesBud,\r\na.code_b as BU,\r\na.amount as SalesBudAmt\r\nfrom\r\n\r\nifsapp.BUDGET_PERIOD_AMOUNT1 a\r\n\r\nwhere\r\na.company = 'GRISL' and a.budget_year = '2025' and a.budget_version = 'SALESTAR'"
            }
          },
          "partitionSettings": {
            "partitionOption": "None"
          }
        },
